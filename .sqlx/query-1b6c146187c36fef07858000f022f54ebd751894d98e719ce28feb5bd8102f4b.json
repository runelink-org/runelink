{
  "db_name": "PostgreSQL",
  "query": "\n        INSERT INTO users (name, host, role)\n        SELECT $1, $2, $3\n        WHERE NOT EXISTS (\n            SELECT 1 FROM deleted_users\n            WHERE name = $1 AND host = $2\n                AND deleted_at > NOW() - make_interval(secs => $4)\n        )\n        RETURNING\n            name,\n            host,\n            role AS \"role: UserRole\",\n            created_at,\n            updated_at,\n            synced_at;\n        ",
