  "query": "\n        UPDATE server_channels sc\n        SET parent_channel_id = p.parent_channel_id, position = p.position\n        FROM UNNEST($1::UUID[], $2::UUID[], $3::INTEGER[])\n            AS p (id, parent_channel_id, position)\n        WHERE sc.id = p.id\n        RETURNING sc.*;\n        ",
