{
  "db_name": "PostgreSQL",
  "query": "\n        INSERT INTO server_channels (\n            server_id, kind, title, description, text_channel_id,\n            parent_channel_id, position\n        )\n        VALUES ($1, $2, $3, $4, $5, $6, (\n            SELECT COALESCE(MAX(position) + 1, 0)\n            FROM server_channels\n            WHERE server_id = $1\n                AND parent_channel_id IS NOT DISTINCT FROM $6\n        ))\n        RETURNING *;\n        ",
