{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            m.id,\n            m.text_channel_id,\n            m.body,\n            m.created_at,\n            m.updated_at,\n            to_jsonb(a) AS \"author: Json<User>\"\n        FROM messages m\n        LEFT JOIN users a ON a.name = m.author_name AND a.host = m.author_host\n        ORDER BY m.created_at DESC;\n        ",
