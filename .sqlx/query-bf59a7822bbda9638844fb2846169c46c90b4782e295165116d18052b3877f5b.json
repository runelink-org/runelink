  "query": "\n        SELECT c.server_id, m.text_channel_id, m.author_name,\n            m.author_host AS \"author_host: Host\"\n        FROM messages m\n        JOIN server_channels c ON c.text_channel_id = m.text_channel_id\n        WHERE m.id = $1\n        ",
